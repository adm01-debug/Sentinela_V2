# ============================================================
# SENTINELA - Production Environment Variables
# ============================================================
# Note: NODE_ENV is managed automatically by Vite during build
# Do NOT set NODE_ENV here - it will cause build warnings

# API Configuration
VITE_API_URL=https://api.sentinela.app

# Supabase Configuration (set in Vercel/hosting environment variables)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Error Tracking
# VITE_SENTRY_DSN=your-sentry-dsn
# VITE_APP_VERSION=1.0.0
