{
  "name": "securewatch-agent",
  "version": "1.0.0",
  "description": "SecureWatch Desktop Monitoring Agent",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "tsc && electron .",
    "build": "tsc",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.securewatch.agent",
    "productName": "SecureWatch Agent",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "active-win": "^8.1.0",
    "electron-store": "^8.1.0",
    "iohook": "^0.9.3",
    "node-fetch": "^2.7.0",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.33.0",
    "systeminformation": "^5.21.0",
    "tesseract.js": "^5.0.0",
    "usb-detection": "^4.14.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.0"
  }
}
