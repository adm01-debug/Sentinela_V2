{
  "name": "sentinela-agent",
  "version": "1.0.0",
  "description": "Sentinela Desktop Monitoring Agent",
  "main": "dist/main/main.js",
  "author": "Sentinela",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --win",
    "build:dir": "electron-vite build && electron-builder --win --dir",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "active-win": "^8.1.0",
    "auto-launch": "^5.0.6",
    "electron-log": "^5.1.7",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.7",
    "iohook": "^0.9.3",
    "node-usb": "^2.9.0",
    "screenshot-desktop": "^1.15.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/auto-launch": "^5.0.5",
    "@types/uuid": "^9.0.7",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.sentinela.agent",
    "productName": "Sentinela Agent",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis"],
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "runAfterFinish": true,
      "installerSidebar": null
    },
    "publish": {
      "provider": "generic",
      "url": "https://releases.sentinela.app/agent"
    }
  }
}
