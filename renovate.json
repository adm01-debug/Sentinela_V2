{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch"], "automerge": true },
    { "matchPackagePatterns": ["*"], "groupName": "all dependencies" }
  ],
  "schedule": ["before 3am on Monday"]
}