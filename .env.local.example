# Local Development
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your_local_anon_key
VITE_API_URL=http://localhost:3000
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_BETA_FEATURES=true
# Chave publica VAPID (base64url, 65 bytes) para push no navegador.
# O par e gerado com scripts/generate-vapid-keys.ts; a privada vai como secret
# VAPID_PRIVATE_KEY nas edge functions (nunca no front).
VITE_VAPID_PUBLIC_KEY=
